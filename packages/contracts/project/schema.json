{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planwise.invalid/schemas/project-planner-v1.json",
  "title": "Planwise Project Planner Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "tasks", "dependencies", "calendar", "options"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "tasks": {"type":"array","minItems":0,"maxItems":200,"items":{"$ref":"#/$defs/task"}},
    "dependencies": {"type":"array","minItems":0,"maxItems":19900,"items":{"$ref":"#/$defs/dependency"}},
    "calendar": {"$ref":"#/$defs/calendar"},
    "options": {"$ref":"#/$defs/options"}
  },
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "name": {"type":"string","minLength":1,"maxLength":256},
    "date": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$","minLength":10,"maxLength":10},
    "finiteNonNegative": {"type":"number","minimum":0},
    "fixedDuration": {"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"const":"fixed"},"value":{"$ref":"#/$defs/finiteNonNegative"}}},
    "pertDuration": {"type":"object","additionalProperties":false,"required":["kind","optimistic","mostLikely","pessimistic"],"properties":{"kind":{"const":"pert"},"optimistic":{"$ref":"#/$defs/finiteNonNegative"},"mostLikely":{"$ref":"#/$defs/finiteNonNegative"},"pessimistic":{"$ref":"#/$defs/finiteNonNegative"}}},
    "duration": {"oneOf":[{"$ref":"#/$defs/fixedDuration"},{"$ref":"#/$defs/pertDuration"}]},
    "task": {"type":"object","additionalProperties":false,"required":["id","name","duration"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/name"},"duration":{"$ref":"#/$defs/duration"}}},
    "dependency": {"type":"object","additionalProperties":false,"required":["predecessorId","successorId"],"properties":{"predecessorId":{"$ref":"#/$defs/id"},"successorId":{"$ref":"#/$defs/id"}}},
    "calendar": {"type":"object","additionalProperties":false,"required":["unit","referenceDate","timezone","workingWeekdays","nonWorkingDates"],"properties":{"unit":{"enum":["calendar-day","workday"]},"referenceDate":{"$ref":"#/$defs/date"},"timezone":{"type":"string","minLength":1,"maxLength":64},"workingWeekdays":{"type":"array","minItems":1,"maxItems":7,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":6}},"nonWorkingDates":{"type":"array","maxItems":3660,"uniqueItems":true,"items":{"$ref":"#/$defs/date"}}}},
    "options": {"type":"object","additionalProperties":false,"required":["calculatePertExpectedDuration","checkDeadline"],"properties":{"calculatePertExpectedDuration":{"type":"boolean"},"checkDeadline":{"type":"boolean"},"deadline":{"$ref":"#/$defs/date"}}},
    "input": {"$ref":"#"},
    "error": {"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"path":{"type":"string"},"taskIds":{"type":"array","items":{"$ref":"#/$defs/id"}}}},
    "scheduleEntry": {"type":"object","additionalProperties":false,"required":["taskId","duration","startOffset","finishOffset","startDate","finishDate","earliestStart","earliestFinish","latestStart","latestFinish","float","critical"],"properties":{"taskId":{"$ref":"#/$defs/id"},"duration":{"type":"number","minimum":0},"startOffset":{"type":"number"},"finishOffset":{"type":"number"},"startDate":{"$ref":"#/$defs/date"},"finishDate":{"$ref":"#/$defs/date"},"earliestStart":{"type":"number"},"earliestFinish":{"type":"number"},"latestStart":{"type":"number"},"latestFinish":{"type":"number"},"float":{"type":"number","minimum":0},"critical":{"type":"boolean"}}},
    "result": {"type":"object","additionalProperties":false,"required":["contractVersion","status","duration","durationUnit","projectStartDate","projectFinishDate","schedule","criticalPaths","pertExpectedDurations","warnings"],"properties":{"contractVersion":{"const":"1.0.0"},"status":{"enum":["ok","invalid-input","cycle","impossible-schedule"]},"duration":{"type":"number","minimum":0},"durationUnit":{"enum":["calendar-day","workday"]},"projectStartDate":{"$ref":"#/$defs/date"},"projectFinishDate":{"$ref":"#/$defs/date"},"schedule":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/scheduleEntry"}},"criticalPaths":{"type":"array","items":{"type":"array","items":{"$ref":"#/$defs/id"}}},"pertExpectedDurations":{"type":"object","additionalProperties":{"type":"number","minimum":0}},"warnings":{"type":"array","items":{"type":"string"}},"deadline":{"type":"object","additionalProperties":false,"required":["deadline","feasible","finishDate"],"properties":{"deadline":{"$ref":"#/$defs/date"},"feasible":{"type":"boolean"},"finishDate":{"$ref":"#/$defs/date"}}}}},
    "workspaceEnvelope": {"type":"object","additionalProperties":false,"required":["format","schemaVersion","tool","savedAt","payload"],"properties":{"format":{"const":"planwise-workspace"},"schemaVersion":{"const":1},"tool":{"const":"project"},"savedAt":{"type":"string","format":"date-time"},"payload":{"$ref":"#/$defs/input"}}}
  }
}
