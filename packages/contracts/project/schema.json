{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://planwise.invalid/schemas/project-planner-v1.1.json",
  "title":"Planwise Project Planner Contract v1.1",
  "type":"object","additionalProperties":false,
  "required":["contractVersion","tasks","dependencies","calendar","options"],
  "properties":{"contractVersion":{"const":"1.1.0"},"tasks":{"type":"array","minItems":0,"maxItems":200,"items":{"$ref":"#/$defs/task"}},"dependencies":{"type":"array","minItems":0,"maxItems":19900,"items":{"$ref":"#/$defs/dependency"}},"calendar":{"$ref":"#/$defs/calendar"},"options":{"$ref":"#/$defs/options"}},
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "finiteNonNegative":{"type":"number","minimum":0,"maximum":1000000},
    "fixed":{"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"const":"fixed"},"value":{"$ref":"#/$defs/finiteNonNegative"}}},
    "pert":{"type":"object","additionalProperties":false,"required":["kind","optimistic","mostLikely","pessimistic"],"properties":{"kind":{"const":"pert"},"optimistic":{"$ref":"#/$defs/finiteNonNegative"},"mostLikely":{"$ref":"#/$defs/finiteNonNegative"},"pessimistic":{"$ref":"#/$defs/finiteNonNegative"}}},
    "duration":{"oneOf":[{"$ref":"#/$defs/fixed"},{"$ref":"#/$defs/pert"}]},
    "task":{"type":"object","additionalProperties":false,"required":["id","name","duration"],"properties":{"id":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":1,"maxLength":256},"duration":{"$ref":"#/$defs/duration"}}},
    "dependency":{"type":"object","additionalProperties":false,"required":["predecessorId","successorId"],"properties":{"predecessorId":{"$ref":"#/$defs/id"},"successorId":{"$ref":"#/$defs/id"}}},
    "calendar":{"type":"object","additionalProperties":false,"required":["unit","referenceDate","timezone","workingWeekdays","nonWorkingDates"],"properties":{"unit":{"enum":["calendar-day","workday"]},"referenceDate":{"$ref":"#/$defs/date"},"timezone":{"type":"string","minLength":1,"maxLength":64},"workingWeekdays":{"type":"array","minItems":1,"maxItems":7,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":6}},"nonWorkingDates":{"type":"array","maxItems":3660,"uniqueItems":true,"items":{"$ref":"#/$defs/date"}}}},
    "options":{"type":"object","additionalProperties":false,"required":["calculatePertExpectedDuration","checkDeadline"],"properties":{"calculatePertExpectedDuration":{"type":"boolean"},"checkDeadline":{"type":"boolean"},"deadline":{"$ref":"#/$defs/date"}}},
    "scheduleEntry":{"type":"object","additionalProperties":false,"required":["taskId","duration","startOffset","finishOffset","startDate","finishDate","earliestStart","earliestFinish","latestStart","latestFinish","float","critical"],"properties":{"taskId":{"$ref":"#/$defs/id"},"duration":{"$ref":"#/$defs/finiteNonNegative"},"startOffset":{"type":"number"},"finishOffset":{"type":"number"},"startDate":{"$ref":"#/$defs/date"},"finishDate":{"$ref":"#/$defs/date"},"earliestStart":{"type":"number"},"earliestFinish":{"type":"number"},"latestStart":{"type":"number"},"latestFinish":{"type":"number"},"float":{"type":"number","minimum":0},"critical":{"type":"boolean"}}},
    "criticalPathSummary":{"type":"object","additionalProperties":false,"required":["paths","truncated","totalPathCount"],"properties":{"paths":{"type":"array","maxItems":1024,"items":{"type":"array","items":{"$ref":"#/$defs/id"}}},"truncated":{"type":"boolean"},"totalPathCount":{"type":"string","pattern":"^[0-9]+$"}}},
    "result":{"type":"object","additionalProperties":false,"required":["contractVersion","status","duration","durationUnit","projectStartDate","projectFinishDate","schedule","criticalPaths","pertExpectedDurations","warnings"],"properties":{"contractVersion":{"const":"1.1.0"},"status":{"const":"ok"},"duration":{"$ref":"#/$defs/finiteNonNegative"},"durationUnit":{"enum":["calendar-day","workday"]},"projectStartDate":{"$ref":"#/$defs/date"},"projectFinishDate":{"$ref":"#/$defs/date"},"schedule":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/scheduleEntry"}},"criticalPaths":{"$ref":"#/$defs/criticalPathSummary"},"pertExpectedDurations":{"type":"object","additionalProperties":{"$ref":"#/$defs/finiteNonNegative"}},"warnings":{"type":"array","items":{"type":"string","maxLength":1024}},"deadline":{"type":"object","additionalProperties":false,"required":["deadline","feasible","finishDate"],"properties":{"deadline":{"$ref":"#/$defs/date"},"feasible":{"type":"boolean"},"finishDate":{"$ref":"#/$defs/date"}}}}},
    "error":{"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"enum":["SCHEMA_VALIDATION_ERROR","UNSUPPORTED_VERSION","UNKNOWN_FIELD","IMPORT_TOO_LARGE","IMPORT_TOO_DEEP","IMPORT_STRING_BUDGET_EXCEEDED","IMPORT_TRAVERSAL_BUDGET_EXCEEDED","DUPLICATE_TASK_ID","MISSING_TASK_ID","MISSING_PREDECESSOR","MISSING_SUCCESSOR","INVALID_DURATION","INVALID_PERT_ORDER","CYCLE_DETECTED","INVALID_DATE","INVALID_CALENDAR","DEADLINE_INFEASIBLE","DURATION_HORIZON_EXCEEDED"]},"message":{"type":"string","minLength":1},"path":{"type":"string"},"taskIds":{"type":"array","items":{"$ref":"#/$defs/id"}}}},
    "response":{"oneOf":[{"type":"object","additionalProperties":false,"required":["ok","result"],"properties":{"ok":{"const":true},"result":{"$ref":"#/$defs/result"}}},{"type":"object","additionalProperties":false,"required":["ok","error"],"properties":{"ok":{"const":false},"error":{"$ref":"#/$defs/error"}}}]},
    "envelope":{"type":"object","additionalProperties":false,"required":["format","schemaVersion","tool","savedAt","payload"],"properties":{"format":{"const":"planwise-workspace"},"schemaVersion":{"const":2},"tool":{"const":"project"},"savedAt":{"type":"string","format":"date-time"},"payload":{"type":"object","additionalProperties":false,"required":["contractVersion","tasks","dependencies","calendar","options"],"properties":{"contractVersion":{"const":"1.1.0"},"tasks":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/task"}},"dependencies":{"type":"array","maxItems":19900,"items":{"$ref":"#/$defs/dependency"}},"calendar":{"$ref":"#/$defs/calendar"},"options":{"$ref":"#/$defs/options"}}}}}
  }
}
